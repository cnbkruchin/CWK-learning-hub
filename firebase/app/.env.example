# ค่าโปรเจกต์ Firebase (Project settings → Your apps → Web app → SDK setup and configuration)
# ค่าเหล่านี้ไม่ใช่ความลับ ความปลอดภัยอยู่ที่ Security Rules และ Cloud Functions
# คัดลอกเป็น app/.env.local แล้วกรอกค่า
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# รหัสโรงเรียนเริ่มต้นในหน้าเข้าสู่ระบบ
VITE_SCHOOL_CODE=CWK
